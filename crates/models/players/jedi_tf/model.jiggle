// DinurdoJK stock-_humanoid post-skin secondary motion profile.
// Coordinates were measured from jedi_tf/model.glm bind-pose LODs.
// `anchor auto` derives the spring target from the selected vertices' real GLM skin weights.
version 1

region breast_left
surface torsob
surface torsob_skin
anchor auto
side positive_x
center 2.40 -3.20 51.30
radius 3.20 3.20 4.40
response 0.28 1.00 0.65
stiffness 0.10
damping 0.18
max_offset 1.15
strength 1.0
end

region breast_right
surface torsob
surface torsob_skin
anchor auto
side negative_x
center -2.40 -3.20 51.30
radius 3.20 3.20 4.40
response 0.28 1.00 0.65
stiffness 0.10
damping 0.18
max_offset 1.15
strength 1.0
end

// Posterior soft-tissue regions measured from the active hips-B skin surfaces.
// These use the authored femur/pelvis blend through `anchor auto`, so the target
// follows normal leg/hip animation while the spring contributes secondary motion.
region glute_left
surface hipsb
surface hipsb_lskin
anchor auto
side positive_x
center 4.40 3.40 33.05
radius 5.00 3.60 6.15
response 0.20 0.85 0.85
stiffness 0.12
damping 0.20
max_offset 0.95
strength 1.0
end

region glute_right
surface hipsb
surface hipsb_rskin
anchor auto
side negative_x
center -4.40 3.40 33.05
radius 5.00 3.60 6.15
response 0.20 0.85 0.85
stiffness 0.12
damping 0.20
max_offset 0.95
strength 1.0
end
